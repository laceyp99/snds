root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads BOM-less scripts as ANSI; keep a BOM and CRLF (see .gitattributes).
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf
