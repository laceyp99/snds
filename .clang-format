# C++ style for SNDS-owned code (src/, tests/cpp/), following JUCE conventions: Allman braces,
# four-space indents, and a space before call and declaration parentheses. Apply it with
# scripts\format.ps1, which pins the clang-format version.
Language: Cpp
Standard: c++20
BasedOnStyle: LLVM

ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
ConstructorInitializerIndentWidth: 4
NamespaceIndentation: None
IndentCaseLabels: true
LambdaBodyIndentation: Signature

BreakBeforeBraces: Allman
BreakBeforeBinaryOperators: NonAssignment
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: Never
BreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: OnePerLine
AlignAfterOpenBracket: Align
AlignOperands: AlignAfterOperator
AlignTrailingComments: true
PenaltyReturnTypeOnItsOwnLine: 200

AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

SpaceBeforeParens: NonEmptyParentheses
SpaceAfterLogicalNot: true
SpaceAfterCStyleCast: true
SpaceBeforeCpp11BracedList: true
Cpp11BracedListStyle: false
SpacesInContainerLiterals: true
PointerAlignment: Left
ReferenceAlignment: Left

FixNamespaceComments: true
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
InsertNewlineAtEOF: true
# Keep each file's existing line endings: Git converts them, and CRLF checkouts must pass -Check.
LineEnding: DeriveLF
