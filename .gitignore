# Build trees. Scripts build into build/; IDEs may create the others.
/build/
/build-*/
/out/
/.vs/
CMakeUserPresets.json
*.user

# Python worker environment and tool caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Model weights. Bootstrap downloads the checkpoint into the SNDS data directory.
*.th
*.pt
*.pth
*.ckpt
*.safetensors

# Logs and audio outputs. Settings, cache, jobs, logs, and models live under SNDS_HOME
# (default %LOCALAPPDATA%\snds), never in the source tree. Rights-cleared fixtures belong in
# testdata/.
*.log
logs/
*.wav
*.mp3
*.flac
!/testdata/**/*.wav
!/testdata/**/*.mp3
!/testdata/**/*.flac

# Local planning artifacts
/plan.md
/decisions.md
